@AgriStore.Api_HostAddress = http://localhost:5274
@userId = 00000000-0000-0000-0000-000000000000
@warehouseId = 00000000-0000-0000-0000-000000000000
@purchaseOrderId = 00000000-0000-0000-0000-000000000000
@purchaseOrderDetailId = 00000000-0000-0000-0000-000000000000
@productId = 00000000-0000-0000-0000-000000000000
@token = paste-jwt-token-here

### Đăng ký tài khoản Customer
POST {{AgriStore.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
	"fullName": "Nguyen Van A",
	"email": "new.customer@example.com",
	"phoneNumber": "0900000000",
	"password": "AgriStore123"
}

### Đăng nhập và nhận access token
# Refresh token được API đặt trong HttpOnly cookie.
POST {{AgriStore.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
	"email": "customer@agristore.local",
	"password": "AgriStore123"
}

### Refresh access token bằng cookie
POST {{AgriStore.Api_HostAddress}}/api/auth/refresh

### Đăng xuất và xóa refresh-token cookie
POST {{AgriStore.Api_HostAddress}}/api/auth/logout

### Đổi mật khẩu khi đã đăng nhập
POST {{AgriStore.Api_HostAddress}}/api/auth/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"currentPassword": "AgriStore123",
	"newPassword": "AgriStore456"
}

### Quên mật khẩu (demo: token được trả trong response)
POST {{AgriStore.Api_HostAddress}}/api/auth/forgot-password
Content-Type: application/json

{
	"email": "admin@agristore.local"
}

### Đặt lại mật khẩu bằng token từ request trước
POST {{AgriStore.Api_HostAddress}}/api/auth/reset-password
Content-Type: application/json

{
	"email": "admin@agristore.local",
	"token": "paste-reset-token-here",
	"newPassword": "AgriStore456"
}

### Danh sách user
GET {{AgriStore.Api_HostAddress}}/api/users?page=1&pageSize=20&search=&isActive=true
Authorization: Bearer {{token}}
Accept: application/json

### Chi tiết user
GET {{AgriStore.Api_HostAddress}}/api/users/{{userId}}
Authorization: Bearer {{token}}
Accept: application/json

### Cập nhật user
PUT {{AgriStore.Api_HostAddress}}/api/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"fullName": "Nguyen Van A",
	"email": "user@example.com",
	"phoneNumber": "0900000000",
	"avatar": "https://example.com/avatar.png",
	"roles": ["Staff"]
}

### Khóa user
PATCH {{AgriStore.Api_HostAddress}}/api/users/{{userId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"isActive": false
}

### Mở khóa user
PATCH {{AgriStore.Api_HostAddress}}/api/users/{{userId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"isActive": true
}

### Thêm sản phẩm vào đơn nhập
POST {{AgriStore.Api_HostAddress}}/api/purchase-orders/{{purchaseOrderId}}/details
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"productId": "{{productId}}",
	"quantity": 10,
	"unitPrice": 25000
}

### Xác nhận đơn nhập (Draft -> Ordered)
POST {{AgriStore.Api_HostAddress}}/api/purchase-orders/{{purchaseOrderId}}/order
Authorization: Bearer {{token}}
Accept: application/json

### Nhận hàng một lần (Ordered -> Received; số thực nhận có thể thấp hơn số đặt)
POST {{AgriStore.Api_HostAddress}}/api/purchase-orders/{{purchaseOrderId}}/receive
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "details": [
    {
      "detailId": "{{purchaseOrderDetailId}}",
      "receivedQuantity": 8
    }
  ]
}

### Xóa sản phẩm khỏi đơn nhập
DELETE {{AgriStore.Api_HostAddress}}/api/purchase-orders/{{purchaseOrderId}}/details/{{purchaseOrderDetailId}}
Authorization: Bearer {{token}}
Accept: application/json

###

@categoryId = 00000000-0000-0000-0000-000000000000
@parentCategoryId = 00000000-0000-0000-0000-000000000000

### Danh sách danh mục
GET {{AgriStore.Api_HostAddress}}/api/categories?page=1&pageSize=20&isActive=true
Authorization: Bearer {{token}}
Accept: application/json

### Lấy danh mục con trực tiếp
GET {{AgriStore.Api_HostAddress}}/api/categories?parentId={{parentCategoryId}}&page=1&pageSize=20
Authorization: Bearer {{token}}
Accept: application/json

### Chi tiết danh mục
GET {{AgriStore.Api_HostAddress}}/api/categories/{{categoryId}}
Authorization: Bearer {{token}}
Accept: application/json

### Tạo danh mục cha
POST {{AgriStore.Api_HostAddress}}/api/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"name": "Hạt giống",
	"description": "Các loại hạt giống",
	"image": "https://example.com/seeds.png",
	"isActive": true,
	"sortOrder": 0
}

### Tạo danh mục con
POST {{AgriStore.Api_HostAddress}}/api/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"name": "Hạt giống rau",
	"parentId": "{{parentCategoryId}}",
	"isActive": true,
	"sortOrder": 0
}

### Cập nhật danh mục
PUT {{AgriStore.Api_HostAddress}}/api/categories/{{categoryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"name": "Hạt giống rau ăn lá",
	"description": "Hạt giống các loại rau ăn lá",
	"parentId": "{{parentCategoryId}}",
	"isActive": true,
	"sortOrder": 1
}

### Đổi trạng thái danh mục
PATCH {{AgriStore.Api_HostAddress}}/api/categories/{{categoryId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"isActive": false
}

### Xóa mềm danh mục
DELETE {{AgriStore.Api_HostAddress}}/api/categories/{{categoryId}}
Authorization: Bearer {{token}}
Accept: application/json

###

@unitId = 00000000-0000-0000-0000-000000000000

### Danh sách đơn vị tính
GET {{AgriStore.Api_HostAddress}}/api/units?page=1&pageSize=20&search=kg
Authorization: Bearer {{token}}
Accept: application/json

### Chi tiết đơn vị tính
GET {{AgriStore.Api_HostAddress}}/api/units/{{unitId}}
Authorization: Bearer {{token}}
Accept: application/json

### Tạo đơn vị tính
POST {{AgriStore.Api_HostAddress}}/api/units
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"name": "Bó",
	"symbol": "bó",
	"description": "Đơn vị đếm theo bó"
}

### Cập nhật đơn vị tính
PUT {{AgriStore.Api_HostAddress}}/api/units/{{unitId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"name": "Bó rau",
	"symbol": "bó",
	"description": "Đơn vị đếm rau theo bó"
}

### Xóa đơn vị tính chưa được sử dụng
DELETE {{AgriStore.Api_HostAddress}}/api/units/{{unitId}}
Authorization: Bearer {{token}}

###

@productId = 00000000-0000-0000-0000-000000000000
@productImageId = 00000000-0000-0000-0000-000000000000
@productCategoryId = 00000000-0000-0000-0000-000000000000
@productUnitId = 00000000-0000-0000-0000-000000000000

### Danh sách sản phẩm
GET {{AgriStore.Api_HostAddress}}/api/products?page=1&pageSize=20&search=rau&categoryId={{productCategoryId}}&unitId={{productUnitId}}&minPrice=10000&maxPrice=100000&isActive=true&isFeatured=false&sortBy=sellingPrice&sortDirection=asc
Authorization: Bearer {{token}}
Accept: application/json

### Chi tiết sản phẩm
GET {{AgriStore.Api_HostAddress}}/api/products/{{productId}}
Authorization: Bearer {{token}}
Accept: application/json

### Upload một ảnh sản phẩm (thay đường dẫn file mẫu bên dưới)
POST {{AgriStore.Api_HostAddress}}/api/products/{{productId}}/images
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=AgriStoreImageBoundary

--AgriStoreImageBoundary
Content-Disposition: form-data; name="file"; filename="product.jpg"
Content-Type: image/jpeg

< ./path/to/product.jpg
--AgriStoreImageBoundary--

### Đặt ảnh chính
PATCH {{AgriStore.Api_HostAddress}}/api/products/{{productId}}/images/{{productImageId}}/main
Authorization: Bearer {{token}}

### Xóa ảnh sản phẩm
DELETE {{AgriStore.Api_HostAddress}}/api/products/{{productId}}/images/{{productImageId}}
Authorization: Bearer {{token}}

### Tạo sản phẩm
POST {{AgriStore.Api_HostAddress}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"code": "RAU-001",
	"name": "Rau cải xanh",
	"categoryId": "{{productCategoryId}}",
	"unitId": "{{productUnitId}}",
	"description": "Rau cải xanh tươi",
	"shortDescription": "Cải xanh",
	"costPrice": 12000,
	"sellingPrice": 18000,
	"minStockAlert": 5,
	"expiryDays": 7,
	"isActive": true,
	"isFeatured": false
}

### Cập nhật sản phẩm
PUT {{AgriStore.Api_HostAddress}}/api/products/{{productId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"code": "RAU-001",
	"name": "Rau cải xanh tươi",
	"categoryId": "{{productCategoryId}}",
	"unitId": "{{productUnitId}}",
	"description": "Rau cải xanh tươi",
	"shortDescription": "Cải xanh",
	"costPrice": 12000,
	"sellingPrice": 18000,
	"minStockAlert": 5,
	"expiryDays": 7,
	"isActive": true,
	"isFeatured": false
}

### Ngừng kinh doanh sản phẩm
DELETE {{AgriStore.Api_HostAddress}}/api/products/{{productId}}
Authorization: Bearer {{token}}

### Kích hoạt lại sản phẩm
PATCH {{AgriStore.Api_HostAddress}}/api/products/{{productId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"isActive": true
}
### Tra tồn kho theo sản phẩm và/hoặc kho
GET {{AgriStore.Api_HostAddress}}/api/inventories?productId={{productId}}&warehouseId={{warehouseId}}&page=1&pageSize=20
Authorization: Bearer {{token}}
Accept: application/json

### Danh sách tồn kho thấp theo từng kho
GET {{AgriStore.Api_HostAddress}}/api/inventories/low-stock?warehouseId={{warehouseId}}&page=1&pageSize=20
Authorization: Bearer {{token}}
Accept: application/json

###

@orderId = 00000000-0000-0000-0000-000000000000

### Chi tiết đơn hàng, bao gồm các dòng sản phẩm
GET {{AgriStore.Api_HostAddress}}/api/orders/{{orderId}}
Authorization: Bearer {{token}}
Accept: application/json

### Đổi trạng thái đơn hàng
PATCH {{AgriStore.Api_HostAddress}}/api/orders/{{orderId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"status": "Confirmed"
}

### Áp dụng coupon cho đơn Pending
POST {{AgriStore.Api_HostAddress}}/api/orders/{{orderId}}/coupon
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"code": "WELCOME10"
}
